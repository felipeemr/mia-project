# =============================================================================
# MERAKI ARTES DIGITAIS — VARIÁVEIS DE AMBIENTE (Fase 2)
# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA faça commit do .env real — adicione ao .gitignore
# =============================================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Supabase (https://supabase.com) ---
# Crie um projeto gratuito e copie as chaves em: Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- API de Geração de Imagens com IA ---
# Google Gemini (https://aistudio.google.com/apikey) — provedor principal da arte do convite
GEMINI_API_KEY=sua_chave_gemini_aqui
# Opcional: gemini | openai (padrão: gemini se GEMINI_API_KEY existir)
# IMAGE_PROVIDER=gemini
# Itens extras do kit (mascote, prancha, elementos, fundo, papel): KIT_EXTRAS=off desliga (economiza ~US$ 0,27 por geração)
# KIT_EXTRAS=on
# Opcional: modelos do Gemini em ordem de preferência
# GEMINI_POSTER_MODELS=gemini-3-pro-image,gemini-3.1-flash-image-preview

# OpenAI (https://platform.openai.com) — visão, conferência de texto e reserva de imagem
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx

# --- Remoção de Fundo (https://remove.bg) ---
REMOVEBG_API_KEY=sua_chave_removebg_aqui

# --- Gateway de Pagamento (Fase 3) ---
KIWIFY_WEBHOOK_SECRET=seu_secret_aqui
MERCADOPAGO_ACCESS_TOKEN=seu_token_aqui

# --- Armazenamento (Supabase Storage é usado por padrão) ---
# Opcional: AWS S3 para produção avançada
# S3_BUCKET_NAME=meraki-artes-digitais
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=sa-east-1
