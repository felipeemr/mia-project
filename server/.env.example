# =============================================================================
# MERAKI ARTES DIGITAIS — VARIÁVEIS DE AMBIENTE (Fase 2)
# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA faça commit do .env real — adicione ao .gitignore
# =============================================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development

# --- Supabase (https://supabase.com) ---
# Crie um projeto gratuito e copie as chaves em: Settings > API
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# --- API de Geração de Imagens com IA ---
# Google Gemini (https://aistudio.google.com/apikey) — provedor principal da arte do convite
GEMINI_API_KEY=sua_chave_gemini_aqui
# Opcional: gemini | openai (padrão: gemini se GEMINI_API_KEY existir)
# IMAGE_PROVIDER=gemini
# Itens extras do kit (mascote, prancha, elementos, fundo, papel, logotipo, brasão, lembrete, lembrancinha):
# KIT_EXTRAS=off desliga (economiza ~US$ 0,50 por geração; útil para testar só a tela)
# KIT_EXTRAS=on
# Opcional: modelos do Gemini em ordem de preferência
# GEMINI_POSTER_MODELS=gemini-3-pro-image,gemini-3.1-flash-image-preview
# Opcional: modelos dos itens do kit (mascote precisa de rosto fiel; os demais aceitam o modelo mais barato)
# GEMINI_KIT_MASCOT_MODELS=gemini-3-pro-image,gemini-3.1-flash-image-preview
# GEMINI_KIT_ITEM_MODELS=gemini-3.1-flash-image-preview,gemini-3-pro-image

# OpenAI (https://platform.openai.com) — visão, conferência de texto e reserva de imagem
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxx
# Opcional: modelos de imagem da OpenAI (reserva do convite)
# OPENAI_POSTER_MODEL=chatgpt-image-latest
# OPENAI_EDIT_MODEL=chatgpt-image-latest
# OPENAI_IMAGE_MODEL=gpt-image-1

# --- Remoção de Fundo (https://remove.bg) ---
REMOVEBG_API_KEY=sua_chave_removebg_aqui

# --- Pagamento: Mercado Pago (https://www.mercadopago.com.br/developers) ---
# Access Token da aplicação (use o de TESTE enquanto estiver testando; troque pelo de produção para vender)
MERCADOPAGO_ACCESS_TOKEN=seu_token_aqui
# Opcional: assinatura secreta do webhook (Suas integrações > Webhooks). Sem ela a conferência na API já protege.
# MERCADOPAGO_WEBHOOK_SECRET=
# Endereço público do site (https://...). Usado na volta do pagamento e no aviso (webhook). Local: http://localhost:3001
PUBLIC_URL=http://localhost:3001
# Preço do kit em R$ (definido SÓ aqui, no servidor)
KIT_PRICE=47.90
# Prévias grátis por e-mail e versões extras do convite depois de pagar
PREVIEW_ATTEMPTS=2
PAID_EXTRA_ATTEMPTS=2
# Travas de custo: prévias por IP em 24 h e total de prévias por dia (todos os clientes)
IP_DAILY_LIMIT=8
MAX_PREVIEWS_PER_DAY=300
# SÓ PARA TESTE LOCAL sem Mercado Pago: mostra um botão que simula o pagamento. Nunca ligue em produção.
# ALLOW_DEV_PAYMENT=on

# --- Armazenamento (Supabase Storage é usado por padrão) ---
# Opcional: AWS S3 para produção avançada
# S3_BUCKET_NAME=meraki-artes-digitais
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=sa-east-1
